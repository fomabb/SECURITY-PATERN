<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Для отладки конфигурации -->
    <statusListener class="ch.qos.logback.core.status.OnConsoleStatusListener"/>

    <!-- Логи в консоль -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Логи в Loki -->
    <appender name="LOKI" class="com.github.loki4j.logback.Loki4jAppender">
        <http>
            <url>http://localhost:3100/loki/api/v1/push</url>
            <batchMaxItems>500</batchMaxItems>
            <batchMaxBytes>4194304</batchMaxBytes>
            <batchTimeout>2000</batchTimeout>
            <sendQueueMaxBytes>41943040</sendQueueMaxBytes>
        </http>
        <format>
            <label>
                <pattern>app=${name:-default-app},host=${HOSTNAME:-unknown},level=%level</pattern>
                <readMarkers>true</readMarkers>
            </label>
            <encoder>
                <pattern>%d{yyyy-MM-dd HH:mm} [%thread] %-5level %logger{36} - %msg%n</pattern>
            </encoder>
        </format>
    </appender>

    <!-- Резервное логирование в файл -->
    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>backup.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Настройка уровней логирования -->
    <logger name="org.hibernate" level="INFO"/>

    <!-- Настройка ROOT логгера -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
<!--        <appender-ref ref="LOKI"/>-->
<!--        <appender-ref ref="FILE"/>-->
    </root>
</configuration>